{
  "name": "autodeployer-gui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:bridge\" \"npm:ui\"",
    "ui": "vite",
    "bridge": "node server/bridge.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:detach": "node server/test-detach.mjs"
  },
  "dependencies": {
    "concurrently": "^10.0.7",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.0",
    "vite": "^8.3.6"
  }
}
